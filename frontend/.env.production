VITE_API_URL=https://mobile-money-production-b493.up.railway.app/api
VITE_SOCKET_URL=https://mobile-money-production-b493.up.railway.app

# Web push. From Firebase Console > Project settings > Cloud Messaging >
# Web Push certificates > Generate key pair. Public by design -- Vite compiles
# every VITE_ value into the bundle, and a VAPID public key is meant to ship.
# Leave it unset and web push is simply skipped; nothing else breaks.
VITE_FIREBASE_VAPID_KEY=
