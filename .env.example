# MoneyPay environment template
#
# Copy to .env and fill in. .env is gitignored — this file is the only record
# of what the app expects, so add a line here whenever you add a new variable.
#
#     cp .env.example .env
#
# Every variable below is read somewhere in backend/. Nothing else is.

# =========================
# Server
# =========================
PORT=8080
NODE_ENV=development

# =========================
# Database (MySQL)
# =========================
# Local XAMPP default is root with an empty password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gcash

# =========================
# First admin  ← START HERE ON A NEW DATABASE
# =========================
# A fresh database has tables but NO accounts: nobody can sign in, and the only
# route that creates an admin requires an admin. Without these two the app
# starts and the dashboard is unreachable.
#
# On startup the server creates ONE admin from these values, and only when no
# admin exists yet. It is idempotent — a later start finds the existing account
# and leaves it alone, so a password you changed in the app is never reverted.
#
# The startup log tells you which happened:
#   Default admin created: admin@example.com (adminId 771796)
#   Default admin not created — an admin already exists
#   Default admin not created — no admin exists and ADMIN_EMAIL / ADMIN_PASSWORD are not set
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-chars
ADMIN_NAME=Administrator
ADMIN_PHONE=+211900000000

# =========================
# Auth
# =========================
# Generate a long random string. Anyone holding it can forge a token for any
# account, including admin — never reuse one that has been committed anywhere.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=7d

# =========================
# URLs
# =========================
# FRONTEND_URL is the site the browser loads. The backend adds it to the CORS
# allow-list, so when the frontend and API are on different hosts this must be
# the frontend's origin, not the API's.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
API_URL=http://localhost:8080/api
API_PRODUCTION_URL=http://localhost:8080

# VITE_* are read at BUILD time and inlined into the bundle by Vite. Changing
# them here does nothing to an already-built frontend — rebuild and redeploy.
# For local work Vite reads frontend/.env.development instead.
VITE_API_URL=http://localhost:8080/api
VITE_SOCKET_URL=http://localhost:8080

# =========================
# SMS (optional)
# =========================
# Only needed for verification codes to actually send. Left blank, registration
# still works and the code is written to the database.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =========================
# Misc
# =========================
HEALTHCHECK_PATH=/api/health
HEALTHCHECK_PORT=8080
LOG_LEVEL=info
DB_POOL_MAX=10
DB_POOL_MIN=2

# ---- Email (Contact Us) -------------------------------------------------
# Until these are set, contact messages are stored and shown in
# Admin > Messages only. NOTHING is emailed. Check the real state at
# GET /api/contact/mail-status while signed in as an admin.
#
# Gmail needs an App Password, not the account password:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From address shown to recipients. Defaults to SMTP_USER.
SMTP_FROM=
# Where Contact Us messages are delivered. Defaults to SMTP_USER.
SUPPORT_EMAIL=
